    "package:win": "npm run build && electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^38.4.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.2"
  },
  "homepage": "https://balancevid.com",
  "author": {
    "name": "BalanceVid",
    "email": "noreply@balancevid.com"
  }
}
