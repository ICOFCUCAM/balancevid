{
  "name": "balancevid-take-desktop",
  "productName": "Take",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Take Software for desktop: a multi-camera capture station.",
  "main": "out/main.js",
  "scripts": {
    "build": "node build.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
